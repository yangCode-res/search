# Academic APIs
SEMANTIC_SCHOLAR_API_KEY=
PNSEARCH_USER_AGENT=pnsearch/0.1 contact@example.com

# OpenAI-compatible endpoint (Qwen/vLLM/DashScope compatible)
PNSEARCH_LLM_BASE_URL=http://127.0.0.1:8000/v1
PNSEARCH_LLM_API_KEY=EMPTY
PNSEARCH_REASONER_MODEL=Qwen/Qwen3-8B
PNSEARCH_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B

# Runtime
PNSEARCH_MODE=heuristic
PNSEARCH_MAX_ROUNDS=3
PNSEARCH_MAX_API_CALLS=10
PNSEARCH_BATCH_SIZE=8
PNSEARCH_CANDIDATE_LIMIT=80
PNSEARCH_FINAL_LIMIT=20

